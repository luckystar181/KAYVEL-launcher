{
  "name": "kayvel-launcher",
  "version": "0.2.11",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && node scripts/build-process-snapshot.mjs && node scripts/copy-preload.mjs && vite build",
    "test": "npm run build && node --test tests/*.test.mjs",
    "start": "npm run build && electron .",
    "check": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "package:portable": "npm run build && node scripts/package-portable.mjs"
  },
  "dependencies": {
    "@xmcl/core": "2.13.0",
    "@xmcl/file-transfer": "1.0.6",
    "@xmcl/installer": "5.4.0",
    "@xmcl/unzip": "2.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "undici": "6.29.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "overrides": {
    "undici": "6.29.1"
  },
  "allowScripts": {
    "electron@45.0.0": true
  }
}
